# Copia este archivo como .env y completa los valores. Nunca subas el .env real a git.

# --- Base de datos (SQL Server) ---
DB_SERVER=
DB_DATABASE=
DB_USER=
DB_PASSWORD=
# En producción con base de datos remota: DB_ENCRYPT=true y DB_TRUST_CERT=false
DB_ENCRYPT=false
DB_TRUST_CERT=true

# --- Autenticación ---
JWT_SECRET=

# --- Cloudinary (fotos de productos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Servidor ---
# Dominios del frontend que pueden usar la API, separados por coma
CORS_ORIGINS=http://localhost:4200
# El hosting suele asignarlo solo; en local se usa 3000
PORT=3000
# Clave larga y aleatoria, IGUAL en la API y en el servidor de la tienda (Angular SSR).
# Permite que la tienda consulte la API sin chocar con el límite de peticiones.
SSR_API_KEY=
# Solo en el hosting, si la API está detrás de un proxy (Render, Railway, Nginx...)
# TRUST_PROXY=1
